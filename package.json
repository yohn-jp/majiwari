{
  "name": "majiwari",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic CLI/API-to-MCP adapters and a generic stdio-to-remote-MCP gateway. OpenCodeReview delegation is the first adapter.",
  "workspaces": [
    "adapters/open-code-review",
    "gateway",
    "registry",
    "deployments/cloudflare/worker"
  ],
  "scripts": {
    "start": "npm --workspace @majiwari/adapter-open-code-review start --",
    "gateway": "npm --workspace @majiwari/gateway start --",
    "test": "npm test --workspaces",
    "check": "npm run check --workspaces",
    "doctor": "npm --workspace @majiwari/adapter-open-code-review run doctor --"
  },
  "engines": {
    "node": ">=22.13"
  }
}
