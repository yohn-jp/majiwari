cloudflare_account_id = "replace-with-cloudflare-account-id"
gateway_hostname      = "majiwari-gateway.internal.example.com"
gateway_tunnel_id     = "replace-with-cloudflared-tunnel-id"
public_mcp_hostname   = "mcp.example.com"
# Each MCP client's dynamic-client-registration callback pattern, for example ["https://chatgpt.com/*"]
mcp_access_allowed_redirect_uris = []
# Individual callers allowed through the /mcp Managed OAuth boundary, in addition to mcp_access_allowed_email_domains
mcp_access_allowed_emails = ["operator@example.com"]
