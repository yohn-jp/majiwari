{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "majiwari-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "account_id": "REPLACE_WITH_PROFILE_ACCOUNT_ID",

  "vars": {
    "MCP_ACCESS_TEAM_DOMAIN": "REPLACE_WITH_PROFILE_MCP_ACCESS_TEAM_DOMAIN",
    "MCP_ACCESS_AUDIENCE": "REPLACE_WITH_PROFILE_MCP_ACCESS_AUDIENCE"
  },
  "vpc_services": [
    { "binding": "GATEWAY_VPC", "service_id": "REPLACE_WITH_PROFILE_GATEWAY_VPC_SERVICE_ID" }
  ]
}
