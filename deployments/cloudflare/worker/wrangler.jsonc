{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "majiwari-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // Required by @cloudflare/workers-oauth-provider for Client ID Metadata
  // Document support (see deployments/cloudflare/docs/OAUTH.md).
  "compatibility_flags": ["global_fetch_strictly_public"],

  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // Replace with `wrangler kv namespace create OAUTH_KV`'s id before deploying.
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "CONSENT_STATE",
        "class_name": "ConsentStateDurableObject"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1-consent-state",
      "new_sqlite_classes": ["ConsentStateDurableObject"]
    }
  ],

  "vars": {
    // Internal Tunnel-only origin for the gateway. Never expose this hostname
    // to clients. Replace with the actual cloudflared-issued hostname.
    "GATEWAY_ORIGIN": "https://majiwari-gateway.internal.example/mcp",

    // Cloudflare Access values for the path-scoped /authorize application.
    // Replace all example values before deploying.
    "ACCESS_TEAM_DOMAIN": "https://majiwari.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "REPLACE_WITH_ACCESS_APPLICATION_AUD_TAG",
    "OPERATOR_EMAIL": "operator@example.com"
  }
}
